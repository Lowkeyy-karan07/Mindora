# Google Gemini API key (leave empty here; copy to .env.local and add your key)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Primary Gemini model identifier
GEMINI_MODEL=gemini-2.5-flash-lite

# Fallback Gemini model identifier
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite

# Set to 'true' to run strictly with deterministic rules without calling Gemini
DEMO_MODE=false
